---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostRow from "../components/PostRow.astro";

import {
    getLangFromUrl,
    useTranslations,
    useLocalizedPath,
    getLocalizedBlog,
    getLocalizedProjects,
} from "../i18n/utils";

const url = Astro.url;
const t = useTranslations(url);
const translatePath = useLocalizedPath(url);

// We obtain the current active language
const currentLang = getLangFromUrl(url);

// We get the collections corresponding to that language
const allProjects = await getLocalizedProjects(currentLang);
const allPosts = await getLocalizedBlog(currentLang);

// We apply layout rules (projects must be featured, posts must be 4 most recent)
const featuredProjects = allProjects.filter((project) => project.data.featured);
const latestPosts = allPosts.slice(0, 4);
---

<Layout title="Inés Triviño | Inicio" description="Página portfolio de Inés Triviño" lang="es">
    <Hero />

    <hr class="border-t border-dashed border-primary my-12" />

    <!-- Projects Section -->
    <section class="mb-12 max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8 tracking-wide">
            {t("home.proyectos_recientes")}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                featuredProjects.map((pro) => (
                    <ProjectCard
                        title={pro.data.title}
                        description={pro.data.description}
                        url={translatePath(
                            `${pro.id
                                .split("/")
                                .pop()
                                ?.replace(/\.[^/.]+$/, "")}`,
                        )}
                    />
                ))
            }
        </div>

        <div class="flex justify-center mt-8">
            <a
                href={translatePath("/proyectos")}
                class="btn-retro-text sfx-button"
            >
                {t("home.ver_todos")}
            </a>
        </div>
    </section>

    <hr class="border-t border-dashed border-primary my-12" />

    <section class="mb-6 max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8 tracking-wide">
            {t("home.posts_recientes")}
        </h2>

        <div class="max-w-xl mx-auto flex flex-col gap-2">
            {
                latestPosts.map((post) => (
                    <PostRow
                        title={post.data.title}
                        date={post.data.date}
                        url={translatePath(
                            `${post.id
                                .split("/")
                                .pop()
                                ?.replace(/\.[^/.]+$/, "")}`,
                        )}
                    />
                ))
            }
        </div>

        <div class="flex justify-center mt-8">
            <a href={translatePath("/blog")} class="btn-retro-text sfx-button">
                {t("home.ver_todos")}
            </a>
        </div>
    </section>
</Layout>
