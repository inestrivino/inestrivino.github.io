---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main class="flex flex-col items-center justify-center min-h-screen p-4">
		<h1 class="text-4xl font-bold mb-4 tracking-wider">
			Inés Triviño
		</h1>
		<p class="text-lg text-purple-400 mb-6 text-center w-2/3">
			Página en progreso. Usando Astro, Tailwind CSS y Howler JS. Librería de sonidos de Kenney.
		</p>

		<button
			id="sfx-button"
			class="cursor-pointer border border-purple-500 hover:bg-purple-500 hover:text-black transition-colors duration-200 px-6 py-2 rounded font-bold"
		>
			Botón de prueba
		</button>
	</main>
</Layout>

<script>
  	// @ts-ignore
  	import { Howl } from 'howler';

	// Configuras el sonido
	const click = new Howl({
		src: ["/audio/tone1.ogg"]
	});
	const hover = new Howl({
		src: ["/audio/lowRandom.ogg"]
	});


	// Lo asignas al evento
	const button = document.getElementById("sfx-button");
	button?.addEventListener("click", () => {
		click.play();
	});

	button?.addEventListener("mouseenter", () => {
		hover.play();
	});
</script>
