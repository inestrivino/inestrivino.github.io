---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { Rss } from "@lucide/astro";

import {
    getLangFromUrl,
    useTranslations,
    useLocalizedPath,
    getLocalizedProjects,
} from "../i18n/utils";

const url = Astro.url;
const t = useTranslations(url);
const translatePath = useLocalizedPath(url);

// We obtain the current active language
const currentLang = getLangFromUrl(url);

// We get the collections corresponding to that language
const allProjects = await getLocalizedProjects(currentLang);
---

<Layout
    title={t('proyectos.title')}
    description={t('proyectos.description')}
    lang={currentLang}
>
    <section
        class="w-full max-w-5xl mx-auto p-4 md:p-8 min-h-[calc(100vh-80px)] flex flex-col justify-start"
    >
        <div class="flex justify-between items-end mb-10 mt-4">
            <h1
                class="font-ascii text-4xl md:text-5xl uppercase tracking-wider"
            >
                {t("proyectos.titulo")}
            </h1>
            <button type="button" class="btn-retro-icon sfx-button">
                <Rss />
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                allProjects.length > 0 ? (
                    allProjects.map((pro) => (
                        <ProjectCard
                            title={pro.data.title}
                            description={pro.data.description}
                            url={translatePath(
                                `${pro.id
                                    .split("/")
                                    .pop()
                                    ?.replace(/\.[^/.]+$/, "")}`,
                            )}
                        />
                    ))
                ) : (
                    <p class="text-base py-4">{t("contenido.noContenido")}</p>
                )
            }
        </div>
    </section>
</Layout>
