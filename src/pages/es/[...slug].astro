---
import { getLocalizedBlog, type Locale } from "../../i18n/utils";
import BlogPostPage from "../../components/pages/BlogPostPage.astro";

export async function getStaticPaths() {
    const lang = 'es'; // HARDCODED FOR EACH LANGUAGE
    const blogPosts = await getLocalizedBlog(lang);

    return blogPosts.map((post) => {
        const slug = post.id.replace(`${lang}/`, "").replace(/\.[^/.]+$/, "");

        return {
            params: { slug },
            props: { post, lang },
        };
    });
}

const { post, lang } = Astro.props;
---

<BlogPostPage post={post} lang={lang} />
