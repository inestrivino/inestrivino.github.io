---
import { getLocalizedBlog, type Locale } from "../../i18n/utils";
import { ui } from '../../i18n/ui';
import BlogPostPage from "../../components/pages/BlogPostPage.astro";

export async function getStaticPaths() {
    const supportedLocales = Object.keys(ui) as Locale[];
    const paths = [];

    for (const lang of supportedLocales) {
        const blogPosts = await getLocalizedBlog(lang);

        for (const post of blogPosts) {
            const slug = post.id.replace(`${lang}/`, "");

            paths.push({
                params: { lang, slug },
                props: { post, lang },
            });
        }
    }

    return paths;
}

const { post, lang } = Astro.props;
---

<BlogPostPage post={post} lang={lang} />