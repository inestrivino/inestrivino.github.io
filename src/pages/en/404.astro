---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations, useLocalizedPath } from '../../i18n/utils';

const url = Astro.url;
const t = useTranslations(url);
const translatePath = useLocalizedPath(url);
---

<Layout title="404 - Route Not Found">
    <section
        class="flex w-full max-w-4xl flex-col mx-auto p-4"
    >
        <div
            class="relative w-full bg-secondary p-6 md:p-10"
        >
            <div class="mb-6 border-b border-dashed pb-4">
                <h1
                    class="font-ascii text-4xl md:text-6xl text-primary tracking-wider animate-pulse"
                >
                    ERROR 404
                </h1>
                <p
                    class="mt-2 text-xs font-mono opacity-60 uppercase tracking-widest"
                >
                    [STATUS: REQUESTED_PAGE_NOT_FOUND]
                </p>
            </div>

            <div
                class="space-y-4 font-mono text-sm leading-relaxed"
            >
                <p class="font-bold">
                    > ERROR: Sg_Link_Exception {t('error.error')}.
                </p>

                <p>
                    {t('error.mensaje')}
                </p>

                <div
                    class="bg-secondary border border-primary p-4 text-xs space-y-1 opacity-70"
                >
                    <p>SYSTEM_STACK_TRACE:</p>
                    <p>0x00F404 -> ERR_URL_MISMATCH</p>
                    <p>0x00F405 -> DESTINATION: NULL</p>
                    <p>0x00F406 -> INES_PORTFOLIO_CORE: ABORTED</p>
                </div>
            </div>

            <div class="mt-8 flex justify-center">
                <a href="/" class="btn-retro-text sfx-button">
                    {t('error.inicio')}
                </a>
            </div>
        </div>
    </section>
</Layout>
