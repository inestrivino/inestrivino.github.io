---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PostRow from "../../components/PostsRow.astro";

import { getLangFromUrl, useTranslations, useLocalizedPath } from '../../i18n/utils';

const url = Astro.url;
const t = useTranslations(url);
const translatePath = useLocalizedPath(url);

// Test data
// TO DO: LOAD THEM FROM AVAILABLE LIST OF MARKDOWN PROJECTS AND POSTS
const proyectos = [
    { title: "Título 1", description: "Descripción corta del proyecto" },
    { title: "Título 2", description: "Descripción corta del proyecto" },
    { title: "Título 3", description: "Descripción corta del proyecto" },
    { title: "Título 4", description: "Descripción corta del proyecto" },
];

const posts = [
    { title: "Post de ejemplo", date: "11 Jul. 2026", url: "/blog/post-1" },
    { title: "Post de ejemplo", date: "11 Jul. 2026", url: "/blog/post-2" },
    { title: "Post de ejemplo", date: "11 Jul. 2026", url: "/blog/post-3" },
    { title: "Post de ejemplo", date: "11 Jul. 2026", url: "/blog/post-4" },
];
---

<Layout title="Inés Triviño | Home">
    <Hero />

    <hr class="border-t border-dashed border-primary my-12" />

    <section class="mb-12 max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8 tracking-wide">
            {t("home.proyectos_recientes")}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                proyectos.map((pro) => (
                    <ProjectCard
                        title={pro.title}
                        description={pro.description}
                    />
                ))
            }
        </div>

        <div class="flex justify-center mt-8">
            <a
                href={translatePath("/proyectos")}
                class="btn-retro-text sfx-button"
            >
                {t("home.ver_todos")}
            </a>
        </div>
    </section>

    <hr class="border-t border-dashed border-primary my-12" />

    <section class="mb-6 max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8 tracking-wide">
            {t("home.posts_recientes")}
        </h2>

        <div class="max-w-xl mx-auto flex flex-col gap-2">
            {
                posts.map((post) => (
                    <PostRow
                        title={post.title}
                        date={post.date}
                        url={translatePath(post.url)}
                    />
                ))
            }
        </div>

        <div class="flex justify-center mt-8">
            <a href={translatePath("/blog")} class="btn-retro-text sfx-button">
                {t("home.ver_todos")}
            </a>
        </div>
    </section>
</Layout>
