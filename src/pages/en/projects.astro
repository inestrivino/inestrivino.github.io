---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import {Rss} from "@lucide/astro";

import { getLangFromUrl, useTranslations, useLocalizedPath } from '../../i18n/utils';

const url = Astro.url;
const t = useTranslations(url);

const proyectos = [
    { title: "Proyecto Uno", description: "Descripción corta del proyecto." },
    { title: "Proyecto Dos", description: "Descripción corta del proyecto." },
    { title: "Proyecto Tres", description: "Descripción corta del proyecto." },
    {
        title: "Proyecto Cuatro",
        description: "Descripción corta del proyecto.",
    },
    {
        title: "Proyecto Cinco",
        description: "Descripción corta del proyecto.",
    },
];
---

<Layout title="Inés Triviño - Projects">
    <section
        class="w-full max-w-5xl mx-auto p-4 md:p-8 min-h-[calc(100vh-80px)] flex flex-col justify-start"
    >
        <div class="flex justify-between items-end mb-10 mt-4">
            <h1
                class="font-ascii text-4xl md:text-5xl uppercase tracking-wider"
            >
                {t('proyectos.titulo')}
            </h1>
            <button type="button" class="btn-retro-icon sfx-button">
                <Rss />
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                proyectos.map((pro) => (
                    <ProjectCard
                        title={pro.title}
                        description={pro.description}
                    />
                ))
            }
        </div>
    </section>
</Layout>
