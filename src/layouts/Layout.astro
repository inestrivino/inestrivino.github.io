---
// Global CSS for the website
import "../styles/global.css";

// CRT filter for the website
import CrtFilter from "../components/CrtFilter.astro";

// Common components for all pages
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Página portfolio de Inés Triviño" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>
  </head>
    <CrtFilter />
  <body
    class="bg-secondary text-primary font-mono min-h-screen flex flex-col selection:bg-primary selection:text-secondary"
  >
    <Navbar />

    <main class="flex-grow w-full mx-auto px-4 pt-8 pb-12">
      <slot />
    </main>

    <Footer />
  </body>

  <script>
    import "../utils/audio.js";
  </script>
</html>
