---
// Global CSS for the website
import "../styles/global.css";

// CRT filter for the website
import CrtFilter from "../components/CrtFilter.astro";

// Common components for all pages
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  lang: string;
}

const { title, description, lang } = Astro.props;

import { useLocalizedPath } from "../i18n/utils";

const url = Astro.url;
const translatePath = useLocalizedPath(url);

const rssBlogPath = translatePath("blog.xml");
const rssProjectsPath = translatePath("projects.xml");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <!-- SEO AND METADATA -->
    <meta name="description" content={description} />
    <meta name="author" content="Inés Triviño" />
    <link rel="canonical" href="inestrivino.github.io" />
    <meta name="generator" content={Astro.generator} />

    <!-- UI and Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="inestrivino.github.io"/>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.png" />

    <!-- RSS feeds for self-discovery -->
    <link rel="alternate" type="application/rss+xml" href={rssBlogPath} />
    <link rel="alternate" type="application/rss+xml" href={rssProjectsPath} />

    <!-- CHANGE THEME AND MUTE WITHOUT FLICKER SCRIPT -->
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";
      };

      const theme = getThemePreference();
      if (theme === "light") {
        document.documentElement.classList.add("light");
      } else {
        document.documentElement.classList.remove("light");
      }

      if (
        typeof localStorage !== "undefined" &&
        localStorage.getItem("audio-muted") === "true"
      ) {
        document.documentElement.setAttribute("data-muted", "true");
      }
    </script></head
  >

  <CrtFilter />
  <body
    class="bg-secondary text-primary font-mono min-h-screen flex flex-col selection:bg-primary selection:text-secondary"
  >
    <Navbar />

    <main class="grow w-full mx-auto px-4 pt-8 pb-12">
      <slot />
    </main>

    <Footer />
  </body>

  <script>
    import "../utils/audio.js";
  </script>
</html>
