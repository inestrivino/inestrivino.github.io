---
import Layout from "../../layouts/Layout.astro";
import Hero from "../Hero.astro";
import ProjectCard from "../ProjectCard.astro";
import PostRow from "../PostRow.astro";
import Skills from "../Skills.astro";

import { useTranslations, useLocalizedPath, getLocalizedBlog, getLocalizedProjects, type Locale } from "../../i18n/utils";

const currentLang = (Astro.currentLocale || "es") as Locale;
const t = useTranslations(currentLang);
const translatePath = useLocalizedPath(currentLang);

// We get the collections corresponding to that language
const allProjects = await getLocalizedProjects(currentLang);
const allPosts = await getLocalizedBlog(currentLang);

// We apply layout rules (projects must be featured, posts must be 4 most recent)
const featuredProjects = allProjects.filter((project) => project.data.featured);
const latestPosts = allPosts.slice(0, 4);
---

<Layout
    title={t("home.title")}
    description={t("home.description")}
    lang={currentLang}
>
    <Hero />

    <hr class="border-t border-dashed border-primary my-12" />

    <!-- Skills section -->
    <section class="mb-12, max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8 tracking-wide">
            {t("home.habilidades")}
        </h2>
        <Skills />
    </section>

    <hr class="border-t border-dashed border-primary my-12" />

    <!-- Projects Section -->
    <section class="mb-12 max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8 tracking-wide">
            {t("home.proyectos_recientes")}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                featuredProjects.length > 0 ? (
                    featuredProjects.map((pro) => (
                        <ProjectCard
                            title={pro.data.title},
                            description={pro.data.description},
                            url={pro.data.url},
                            coverImage={pro.data.coverImage},
                            technologies={pro.data.technologies},
                        />
                    ))
                ) : (
                    <p class="text-base py-4">{t("contenido.noContenido")}</p>
                )
            }
        </div>

        <div class="flex justify-center mt-8">
            <a
                href={translatePath("/proyectos")}
                class="btn-retro-text sfx-button"
            >
                {t("home.ver_todos")}
            </a>
        </div>
    </section>

    <hr class="border-t border-dashed border-primary my-12" />

    <section class="mb-6 max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8 tracking-wide">
            {t("home.posts_recientes")}
        </h2>

        <div class="max-w-5xl mx-auto flex flex-col gap-5 w-full">
            {
                latestPosts.length > 0 ? (
                    latestPosts.map((post) => (
                        <PostRow
                            title={post.data.title}
                            date={post.data.date}
                            url={translatePath(`/${post.id}`)}
                        />
                    ))
                ) : (
                    <p class="text-base py-4">{t("contenido.noContenido")}</p>
                )
            }
        </div>

        <div class="flex justify-center mt-8">
            <a href={translatePath("/blog")} class="btn-retro-text sfx-button">
                {t("home.ver_todos")}
            </a>
        </div>
    </section>
</Layout>
