---
import Layout from "../../layouts/Layout.astro";
import Skills from "../Skills.astro";
import { useTranslations, type Locale } from "../../i18n/utils";
import { defaultLang } from "../../i18n/ui";

const currentLang = (Astro.currentLocale || defaultLang) as Locale;
const t = useTranslations(currentLang);
---

<Layout
    title={t("about.title")}
    description={t("about.description")}
    lang={currentLang}
>
    <div class="px-6 py-6 md:py-6 space-y-6">
        <section
            class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 items-center"
        >
            <div class="space-y-6 p-8 md:p-12">
                <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
                    {t("about.titulo")}
                </h1>
                <div class="space-y-4 text-base md:text-lg leading-relaxed">
                    <p>{t("about.parrafo1")}</p>
                    <p>{t("about.parrafo2")}</p>
                </div>
            </div>

            <!-- Right Column: Picture (takes 50% width on desktop) -->
            <div
                class="hidden md:flex border-l border-primary p-8 md:p-12 justify-center items-center"
            >
                <img
                    src="/img/venus.webp"
                    alt={t("art.aboutme")}
                    class="w-full max-w-sm h-auto object-contain"
                    loading="lazy"
                    decoding="async"
                />
            </div>
        </section>

        <hr class="border-t border-dashed border-primary my-12" />

        <section class="max-w-6xl mx-auto space-y-8">
            <div class="space-y-2">
                <h2 class="text-2xl md:text-3xl font-semibold">
                    {t("about.technologies")}
                </h2>
            </div>

            <Skills />
        </section>
    </div>
</Layout>
