---
import Layout from "../../layouts/Layout.astro";
import Skills from "../Skills.astro";
import { useTranslations, type Locale } from "../../i18n/utils";

const currentLang = (Astro.currentLocale || "es") as Locale;
const t = useTranslations(currentLang);

---

<Layout
    title={t("about.title")}
    description={t("about.description")}
    lang={currentLang}
>
    <div class="px-6 py-12 md:py-20 space-y-16">
        <section
            class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center"
        >
            <div class="space-y-6">
                <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
                    {t("about.titulo")}
                </h1>
                <div class="space-y-4 text-base md:text-lg leading-relaxed">
                    <p>
                        {t('about.parrafo1')}
                    </p>
                    <p>
                       {t('about.parrafo2')}
                    </p>
                    <p>
                        {t('about.parrafo3')}
                    </p>
                </div>
            </div>

            <div
                class="hidden md:flex border-t md:border-t-0 md:border-l md:border-primary p-8 items-center justify-center max-w-md"
            >
                <img
                    src="/img/eyes.png"
                    alt={t("art.alt")}
                    class="w-full h-auto max-h-100 object-contain block"
                    loading="lazy"
                    decoding="async"
                />
            </div>
        </section>

        <hr class="border-t border-dashed border-primary my-12" />

        <section class="max-w-6xl mx-auto space-y-8">
            <div class="space-y-2">
                <h2 class="text-2xl md:text-3xl font-semibold">
                    {t('about.technologies')}
                </h2>
            </div>

            <Skills />

        </section>
    </div>
</Layout>
