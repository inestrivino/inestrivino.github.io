---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../ProjectCard.astro";
import RSSButton from "../RSSButton.astro";

import { useTranslations, useLocalizedPath, getLocalizedProjects, type Locale } from "../../i18n/utils";

const currentLang = (Astro.currentLocale || "es") as Locale;
const t = useTranslations(currentLang);
const translatePath = useLocalizedPath(currentLang);

// We get the collections corresponding to that language
const projects = await getLocalizedProjects(currentLang);

const allTechnologies = [
    ...new Set(projects.flatMap((project) => project.data.technologies))
].sort();

// We obtain the rss feed path based on the current language
const rssFeedPath = translatePath("projects.xml");
---

<Layout
    title={t("proyectos.title")}
    description={t("proyectos.description")}
    lang={currentLang}
>
    <section
        class="w-full max-w-5xl mx-auto p-4 md:p-8 min-h-[calc(100vh-80px)] flex flex-col justify-start"
    >
        <div class="flex flex-wrap justify-between items-end mb-10 mt-4">
            <h1
                class="font-ascii text-4xl md:text-5xl tracking-wider"
            >
                {t("proyectos.titulo")}
            </h1>
            <RSSButton href={rssFeedPath} />
        </div>

        <!-- FILTER BUTTONS -->
        <div class="flex items-center gap-2 mb-10 mt-4">
            <label for="tech-filter" class="font-mono text-sm uppercase">
                Filter:
            </label>
            <select
                id="tech-filter"
                class="bg-secondary text-primary border border-primary font-mono px-3 py-1.5 focus:outline-none cursor-pointer"
            >
                <option value="all" selected>all</option>
                {
                    allTechnologies.map((tech) => (
                        <option value={tech}>{tech}</option>
                    ))
                }
            </select>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                projects.length > 0 ? (
                    projects.map((pro) => (
                        <ProjectCard
                            title={pro.data.title},
                            description={pro.data.description},
                            url={pro.data.url},
                            coverImage={pro.data.coverImage},
                            technologies={pro.data.technologies},
                        />
                    ))
                ) : (
                    <p class="text-base py-4">{t("contenido.noContenido")}</p>
                )
            }
        </div>
    </section>

    <script>
    const techSelect = document.getElementById("tech-filter") as HTMLSelectElement | null;
    const projectCards = document.querySelectorAll<HTMLElement>(".project-card");

    if (techSelect) {
        techSelect.addEventListener("change", (e) => {
            const selectedTech = (e.target as HTMLSelectElement).value;

            //for each card it checks whether it includes the desired technology, and if it does not, then it is undisplayed
            projectCards.forEach((card) => {
                const cardTechs: string[] = JSON.parse(card.getAttribute("data-technologies") || "[]");

                if (selectedTech === "all" || cardTechs.includes(selectedTech)) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            });
        });
    }
    </script>
</Layout>
