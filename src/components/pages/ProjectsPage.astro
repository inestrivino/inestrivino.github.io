---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../ProjectCard.astro";
import RSSButton from "../RSSButton.astro";

import {
    getLangFromUrl,
    useTranslations,
    useLocalizedPath,
    getLocalizedProjects,
} from "../../i18n/utils";

const url = Astro.url;
const t = useTranslations(url);
const translatePath = useLocalizedPath(url);

// We obtain the current active language
const currentLang = getLangFromUrl(url);

// We get the collections corresponding to that language
const allProjects = await getLocalizedProjects(currentLang);

// We obtain the rss feed path based on the current language
const rssFeedPath = translatePath("projects.xml");
---

<Layout
    title={t("proyectos.title")}
    description={t("proyectos.description")}
    lang={currentLang}
>
    <section
        class="w-full max-w-5xl mx-auto p-4 md:p-8 min-h-[calc(100vh-80px)] flex flex-col justify-start"
    >
        <div class="flex flex-wrap justify-between items-end mb-10 mt-4">
            <h1
                class="font-ascii text-4xl md:text-5xl tracking-wider"
            >
                {t("proyectos.titulo")}
            </h1>
            <RSSButton href={rssFeedPath} />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                allProjects.length > 0 ? (
                    allProjects.map((pro) => (
                        <ProjectCard
                            title={pro.data.title}
                            description={pro.data.description}
                            coverImage={pro.data.coverImage},
                            technologies={pro.data.technologies},
                            url={translatePath(
                                `${pro.id
                                    .split("/")
                                    .pop()
                                    ?.replace(/\.[^/.]+$/, "")}`,
                            )}
                        />
                    ))
                ) : (
                    <p class="text-base py-4">{t("contenido.noContenido")}</p>
                )
            }
        </div>
    </section>
</Layout>
