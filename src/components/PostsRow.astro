---
interface Props {
  title: string;
  date: string;
  url: string;
}
const { title, date, url } = Astro.props;
---
<a href={url} class="flex justify-between items-center py-2 border-b border-primary transition-colors group">
  <p class="transition-all hover:font-bold">{title}</p>
  <p class="text-primary">{date}</p>
</a>