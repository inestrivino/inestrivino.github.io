---
interface Props {
  title: string;
  date: string;
  url: string;
}
const { title, date, url } = Astro.props;
---
<a href={url} class="flex justify-between items-center py-2 border-b border-[#a7a2e7]/10 hover:text-white transition-colors group">
  <span class="text-sm group-hover:underline">{title}</span>
  <span class="text-xs text-[#a7a2e7]/50">{date}</span>
</a>