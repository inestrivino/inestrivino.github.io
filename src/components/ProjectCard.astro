---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<div class="cursor-pointer border border-primary flex flex-col group hover:border-primary relative bg-inherit sfx-project transition-transform duration-200 ease-out hover:scale-120 z-0 hover:z-10">

  <div class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-primary"></div>
  <div class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-primary"></div>
  <div class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 w-1.5 h-1.5 bg-primary"></div>
  <div class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 w-1.5 h-1.5 bg-primary"></div>

  <div class="bg-primary aspect-video w-full flex items-center justify-center text-secondary font-bold">
    [ preview ]
  </div>
  
  <div class="p-4 bg-secondary flex-grow flex justify-between items-start border-t border-primary">
    <div>
      <h3 class="font-bold group-hover:text-primary">{title}</h3>
      <p class="mt-1">{description}</p>
    </div>
    
    <div class="grid grid-cols-4 gap-1">
      {[...Array(8)].map(() => (
        <div class="w-3 h-3 bg-primary"></div>
      ))}
    </div>
  </div>
</div>