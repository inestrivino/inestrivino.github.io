---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<div class={`space-y-4 p-6 border flex flex-col justify-between ${className}`}>
  <div class="space-y-4">
    <h3 class="text-xl font-medium">
      {title}
    </h3>
    <div class="flex flex-wrap gap-2">
      <slot />
    </div>
  </div>
</div>