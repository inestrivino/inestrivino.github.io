<section
  class="max-w-4xl mx-auto relative mb-12 bg-inherit w-full border border-primary"
>
  <!-- Decorative squares in the border -->
  <div
    class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>
  <div
    class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>

  <!-- Title -->
  <div class="border-b border-primary py-8 px-6 md:py-12 text-center">
    <h1 class="text-3xl md:text-5xl font-ascii font-bold tracking-wider m-0">
      Inés Triviño
    </h1>
  </div>

  <!-- Description -->
  <div class="grid grid-cols-1 md:grid-cols-2">
    <div class="p-8 md:p-12 flex flex-col space-y-8">

      <!-- Description text -->
      <div class="space-y-4 leading-relaxed text-justify">
        <p>
          <strong>Ingeniera de Software.</strong><br />
          Estudiante del Máster de Letras Digitales en la Universidad Complutense
          de Madrid.
        </p>
        <p>
          Disfruto diseñando e implementando proyectos complejos con los que
          poner al límite mis capacidades y aprender nuevas tecnologías.
        </p>
      </div>

      <!-- Buttons -->
      <div class="flex justify-center gap-4 pt-2">
        <a href="#" class="btn-retro-icon" aria-label="Ver Currículum">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
            ></path>
            <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
            <path d="M10 9H8"></path>
            <path d="M16 13H8"></path>
            <path d="M16 17H8"></path>
          </svg>
        </a>

        <a href="#" class="btn-retro-icon" aria-label="GitHub">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>

        <a href="#" class="btn-retro-icon" aria-label="LinkedIn">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      </div>
    </div>

    <!-- Ascii art image -->
    <div
      class="border-t md:border-t-0 md:border-l md:border-primary p-8 md:p-12 flex items-center justify-center"
    >
      <div class="w-full h-full max-w-md">
        <img
          src="/img/AsciiArt.png"
          alt="Arte ASCII decorativo"
          class="w-full h-auto object-contain block"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<!-- Jumping arrow -->
<div class="flex justify-center my-8">
  <span class="text-2xl font-ascii animate-bounce">↓</span>
</div>
