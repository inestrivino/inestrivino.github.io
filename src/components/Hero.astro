---

import { FileUser } from "@lucide/astro";
import { Cat } from "@lucide/astro";
import { Briefcase } from "@lucide/astro";

import {
  getLangFromUrl,
  useTranslations,
  useLocalizedPath,
} from "../i18n/utils";

const url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(url);
const translatePath = useLocalizedPath(url);

---

<section
  class="max-w-4xl mx-auto relative mb-12 bg-inherit w-full border border-primary"
>
  <!-- Decorative squares in the border -->
  <div
    class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>
  <div
    class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 w-2 h-2 bg-primary"
  >
  </div>

  <!-- Title -->
  <div class="border-b border-primary py-8 px-6 md:py-12 text-center">
    <h1 class="text-3xl md:text-5xl font-ascii font-bold tracking-wider m-0">
      Inés Triviño
    </h1>
  </div>

  <!-- Description -->
  <div class="grid grid-cols-1 md:grid-cols-2">
    <div class="p-8 md:p-12 flex flex-col">
      <!-- Description text -->
      <div class="space-y-8 leading-relaxed text-left md:text-justify">
        <p>
          {t('home.descripcion')}
        </p>
      </div>

      <div class="flex justify-center gap-6 pt-8">
        <a
          href="/CV.pdf" target="_blank"
          class="btn-retro-icon btn-retro-big sfx-button"
          aria-label="Ver Currículum"
          data-title={t('tooltip.cv')}
        >
          <FileUser class="w-full h-full" stroke-width="1" />
        </a>

        <a
          href="https://github.com/inestrivino/" target="_blank"
          class="btn-retro-icon btn-retro-big sfx-button"
          aria-label="GitHub"
          data-title="GITHUB"
        >
          <Cat class="w-full h-full" stroke-width="1" />
        </a>

        <a
          href="#" target="_blank"
          class="btn-retro-icon btn-retro-big sfx-button"
          aria-label="LinkedIn"
          data-title="LINKEDIN"
        >
          <Briefcase class="w-full h-full" stroke-width="1" />
        </a>
      </div>
    </div>

    <!-- Ascii art image -->
    <div
      class="hidden md:flex border-t md:border-t-0 md:border-l md:border-primary p-8 items-center justify-center max-w-md"
    >
      <img
          src="/img/statue.png"
          alt={t('art.alt')}
          class="w-full h-auto max-h-100 object-contain block"
          loading="lazy"
          decoding="async"
        />
    </div>
  </div>
</section>

<!-- Jumping arrow -->
<div class="flex justify-center my-8">
  <span class="text-2xl font-ascii animate-bounce">↓</span>
</div>
