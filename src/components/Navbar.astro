---
// Obtains the current route
const { pathname } = Astro.url;

const navItems = [
  { href: "/", label: "inicio" },
  { href: "/yo", label: "sobre mí" },
  { href: "/proyectos", label: "proyectos" },
  { href: "/blog", label: "blog" },
  { href: "/contacto", label: "contacto" },
  { href: "/cli", label: "CLI" },
];

// Function that checks which nav element should be "active"
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};

import { Moon } from "@lucide/astro";
import { Globe } from "@lucide/astro";
import { Volume2 } from "@lucide/astro";
import { Menu } from "@lucide/astro";
import { X } from "@lucide/astro";
---

<header class="sticky top-0 z-50 w-full bg-inherit font-mono py-3">
  <div class="max-w-4xl mx-auto h-16 flex items-center justify-between px-4">
    <!-- Normal menu -->
    <nav class="hidden md:flex items-stretch h-9">
      {
        navItems.map((item, index) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`
                px-3 flex items-center justify-center duration-150
                border border-primary sfx-button
                ${index !== 0 ? "border-l-0" : ""} 
                ${
                  active
                    ? "bg-primary text-secondary font-ascii text-base font-bold"
                    : "text-current hover:bg-primary hover:text-secondary"
                }
              `}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="fixed top-0 right-0 bottom-0 z-50 w-full min-h-screen bg-primary text-secondary flex flex-col items-center justify-center gap-8 p-8 transition-transform duration-300 ease-in-out md:hidden translate-x-full"
    >
      <button
        id="close-menu-btn"
        class="absolute top-6 right-4 btn-retro-icon border-secondary text-secondary"
        aria-label="Cerrar menú"
      >
        <X />
      </button>

      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`
                mobile-menu-link text-3xl font-bold font-ascii tracking-wider uppercase transition-transform active:scale-95
                ${active ? "underline decoration-2 underline-offset-8 text-secondary" : "opacity-80 hover:opacity-100"}
              `}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>

    <div class="flex items-center gap-2">
      <button
        aria-label="Sonido"
        class="btn-retro-icon sfx-button"
        data-title="Sonido"><Volume2 /></button
      >
      <button
        aria-label="Idioma"
        class="btn-retro-icon sfx-button"
        data-title="Idioma"><Globe /></button
      >
      <button
        aria-label="Cambiar tema"
        class="btn-retro-icon sfx-button"
        data-title="Tema"><Moon /></button
      >

      <button
        id="open-menu-btn"
        aria-label="Abrir menú"
        class="btn-retro-icon sfx-button md:hidden"
        data-title="Menú"
      >
        <Menu />
      </button>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("open-menu-btn");
    const closeBtn = document.getElementById("close-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuLinks = document.querySelectorAll(".mobile-menu-link");

    // Function that opens the menu
    openBtn?.addEventListener("click", () => {
      mobileMenu?.classList.remove("translate-x-full");
    });

    // Function that closes the menu
    const closeMenu = () => {
      mobileMenu?.classList.add("translate-x-full");
    };

    closeBtn?.addEventListener("click", closeMenu);

    // The menu is automatically closed when a link is clicked
    menuLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  });
</script>
