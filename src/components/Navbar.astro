---
import { Moon, Sun, Globe, Volume2, VolumeX, Menu, X } from "@lucide/astro";
import {
  useTranslations,
  getTargetRef,
  useLocalizedPath,
  type Locale,
} from "../i18n/utils";
import { languages } from "../i18n/ui.ts";

const currentLang = (Astro.currentLocale || "es") as Locale;
const url = Astro.url;

const t = useTranslations(currentLang);
const translatePath = useLocalizedPath(currentLang);
const getHrefForLang = getTargetRef(url, currentLang);

const navItems = [
  { href: "/", label: t("nav.inicio") },
  { href: "/sobremi", label: t("nav.sobremi") },
  { href: "/proyectos", label: t("nav.proyectos") },
  { href: "/blog", label: "blog" },
];

const baseUrl = import.meta.env.BASE_URL;

const isActive = (href: string) => {
  const targetPath = translatePath(href);
  const cleanPathname = url.pathname.replace(/\/$/, "");
  const expectedPath = targetPath.startsWith(baseUrl)
    ? targetPath
    : `${baseUrl.replace(/\/$/, "")}${targetPath}`;

  return cleanPathname === expectedPath.replace(/\/$/, "");
};
---

<header class="sticky top-0 z-50 w-full bg-inherit font-mono py-3">
  <div class="max-w-4xl mx-auto h-16 flex items-center justify-between px-4">
    <!-- Normal menu -->
    <nav class="hidden md:flex items-stretch h-9">
      {
        navItems.map((item, index) => {
          const active = isActive(item.href);
          return (
            <a
              href={translatePath(item.href)}
              class={`
                px-3 flex items-center justify-center duration-150
                border border-primary sfx-button
                ${index !== 0 ? "border-l-0" : ""} 
                ${
                  active
                    ? "bg-primary text-secondary font-ascii text-base font-bold"
                    : "text-current hover:bg-primary hover:text-secondary"
                }
              `}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="fixed top-0 right-0 bottom-0 z-50 w-full min-h-screen bg-primary text-secondary flex flex-col items-center justify-center gap-8 p-8 transition-transform duration-300 ease-in-out md:hidden translate-x-full"
    >
      <button
        id="close-menu-btn"
        class="absolute top-6 right-4 btn-retro-icon border-secondary text-secondary"
        aria-label="Cerrar menú"
      >
        <X />
      </button>

      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={translatePath(item.href)}
              class={`
                mobile-menu-link text-3xl font-bold font-ascii tracking-wider uppercase transition-transform active:scale-95
                ${active ? "underline decoration-2 underline-offset-8 text-secondary" : "opacity-80 hover:opacity-100"}
              `}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>

    <!-- EXTRA BUTTONS: SOUND, LANGUAGE, AND MENU -->
    <div class="flex items-center gap-2 ml-auto md:ml-0">
      <!-- Sound -->
      <button
        id="audio-toggle"
        aria-label="Sonido"
        class="btn-retro-icon sfx-button"
        data-title={t("tooltip.sonido")}
      >
        <span id="volume-on" class="hidden">
          <Volume2 />
        </span>

        <span id="volume-muted" class="hidden">
          <VolumeX />
        </span>
      </button>

      <!-- Language -->
      <div class="relative inline-block text-left" id="lang-dropdown-wrapper">
        <!-- Dropdown menu button -->
        <button
          id="lang-dropdown-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Seleccionar idioma"
          class="btn-retro-icon sfx-button flex items-center gap-1 pr-2"
          data-title={t("tooltip.idioma")}
        >
          <Globe />
        </button>

        <!-- Dropdown menu items -->
        <div id="lang-dropdown-menu" class="dropdown-menu hidden" role="menu">
          <div class="py-1 flex flex-col">
            {
              Object.entries(languages).map(([code, label]) => {
                const isCurrent = currentLang === code;
                return (
                  <a
                    href={getHrefForLang(code as Locale)}
                    class:list={[
                      "dropdown-item",
                      isCurrent
                        ? "dropdown-item-active"
                        : "dropdown-item-inactive",
                    ]}
                    role="menuitem"
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    <span>{label}</span>
                    {isCurrent && (
                      <span class="text-xs" aria-hidden="true">
                        ●
                      </span>
                    )}
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>

      <button
        id="theme-toggle"
        aria-label={t("tooltip.tema")}
        class="btn-retro-icon sfx-button"
        data-title={t("tooltip.tema")}
      >
        <span id="sun-icon" class="hidden">
          <Sun />
        </span>

        <span id="moon-icon" class="hidden">
          <Moon />
        </span>
      </button>

      <!-- Mobile menu -->
      <button
        id="open-menu-btn"
        aria-label="Abrir menú"
        class="btn-retro-icon sfx-button md:hidden"
        data-title={t("tooltip.menu")}
      >
        <Menu />
      </button>
    </div>
  </div>
</header>

<!-- MUTE BUTTON SCRIPT -->
<script>
  const audioButton = document.getElementById("audio-toggle");
  const volumeOnIcon = document.getElementById("volume-on");
  const volumeMutedIcon = document.getElementById("volume-muted");

  // function to sync the icons to the state of the volume
  const updateAudioIcons = () => {
    const isMuted = document.documentElement.hasAttribute("data-muted");

    if (isMuted) {
      volumeOnIcon?.classList.add("hidden");
      volumeMutedIcon?.classList.remove("hidden");
    } else {
      volumeOnIcon?.classList.remove("hidden");
      volumeMutedIcon?.classList.add("hidden");
    }
  };
  updateAudioIcons();

  // apply mute and update icons when the button is clicked
  audioButton?.addEventListener("click", () => {
    const html = document.documentElement;

    if (html.hasAttribute("data-muted")) {
      html.removeAttribute("data-muted");
      localStorage.setItem("audio-muted", "false");
    } else {
      html.setAttribute("data-muted", "true");
      localStorage.setItem("audio-muted", "true");
    }
    updateAudioIcons();
  });
</script>

<!-- CHANGE THEME SCRIPT -->
<script>
  const toggleButton = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("sun-icon");
  const moonIcon = document.getElementById("moon-icon");

  // Function to sync the icons to the theme
  const updateIcons = () => {
    const isLight = document.documentElement.classList.contains("light");

    if (isLight) {
      sunIcon?.classList.remove("hidden");
      moonIcon?.classList.add("hidden");
    } else {
      sunIcon?.classList.add("hidden");
      moonIcon?.classList.remove("hidden");
    }
  };
  updateIcons();

  // when the button is clicked the html gets light theme and the icon is updated
  toggleButton?.addEventListener("click", () => {
    const element = document.documentElement;
    element.classList.toggle("light");

    const isLight = element.classList.contains("light");
    localStorage.setItem("theme", isLight ? "light" : "dark");
    updateIcons();
  });
</script>

<!-- MOBILE MENU SCRIPT -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("open-menu-btn");
    const closeBtn = document.getElementById("close-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuLinks = document.querySelectorAll(".mobile-menu-link");

    openBtn?.addEventListener("click", () => {
      mobileMenu?.classList.remove("translate-x-full");
    });

    const closeMenu = () => {
      mobileMenu?.classList.add("translate-x-full");
    };

    closeBtn?.addEventListener("click", closeMenu);

    menuLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  });
</script>

<!-- DROPDOWN MENU SCRIPT -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dropdownBtn = document.getElementById("lang-dropdown-btn");
    const dropdownMenu = document.getElementById("lang-dropdown-menu");
    const wrapper = document.getElementById("lang-dropdown-wrapper");

    const toggleDropdown = () => {
      const isHidden = dropdownMenu?.classList.contains("hidden");
      if (isHidden) {
        dropdownMenu?.classList.remove("hidden");
        dropdownBtn?.setAttribute("aria-expanded", "true");
      } else {
        dropdownMenu?.classList.add("hidden");
        dropdownBtn?.setAttribute("aria-expanded", "false");
      }
    };

    dropdownBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    document.addEventListener("click", (event) => {
      if (!wrapper?.contains(event.target as Node)) {
        dropdownMenu?.classList.add("hidden");
        dropdownBtn?.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>
