---
// src/components/CrtFilter.astro
---
<div class="crt-overlay pointer-events-none fixed inset-0 z-50"></div>

<style>
  .crt-overlay {
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%, 
      rgba(0, 0, 0, 0.25) 50%
    );
    background-size: 100% 4px;
    animation: flicker 0.15s infinite;
  }

  /* Efecto de parpadeo sutil */
  @keyframes flicker {
    0% { opacity: 0.97; }
    50% { opacity: 1; }
    100% { opacity: 0.98; }
  }

  /* Ligero brillo a todo el cuerpo */
  :global(body) {
    text-shadow: 0 0 4px rgba(255, 0, 225, 0.6);
  }
</style>