---
// src/components/CrtFilter.astro
---
<div class="crt-overlay pointer-events-none fixed inset-0 z-50"></div>

<style>
  :root {
    --crt-scanline-color: rgba(18, 18, 18, 0.06); 
    --crt-flicker-opacity-min: 0.97;
    --crt-flicker-bright-max: 1.02;
    --text-glow: 0 0 1px rgba(18, 18, 18, 0.1);
  }

  :global(html.light) {
    --text-glow: 0 0 0px rgba(18, 18, 18, 0.1);
  }

  .crt-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    pointer-events: none;
    background: linear-gradient(
      rgba(35, 31, 38, 0) 50%, 
      var(--crt-scanline-color) 50%
    );
    background-size: 100% 4px;
    /* Usamos una animación suavizada unificada */
    animation: crt-flicker-soft 0.25s infinite; 
  }

  @keyframes crt-flicker-soft {
    0% { opacity: var(--crt-flicker-opacity-min); filter: brightness(0.96); }
    50% { opacity: 1; filter: brightness(var(--crt-flicker-bright-max)); }
    100% { opacity: var(--crt-flicker-opacity-min); filter: brightness(0.98); }
  }

  :global(body) {
    text-shadow: var(--text-glow);
    transition: text-shadow 0.3s ease;
  }
</style>