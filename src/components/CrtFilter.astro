---
// src/components/CrtFilter.astro
---
<div class="crt-overlay pointer-events-none fixed inset-0 z-50"></div>

<style>
  .crt-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    pointer-events: none;
    background: linear-gradient(
      rgba(35, 31, 38, 0) 50%, 
      rgba(0, 0, 0, 0.3) 50%
    );
    background-size: 100% 4px;
    animation: 
      flicker 1s infinite, 
  }

  @keyframes flicker-agresivo {
    0% { opacity: 0.9; filter: brightness(0.9); }
    30% { opacity: 1; filter: brightness(1.1); }
    50% { opacity: 0.85; filter: brightness(0.8); }
    80% { opacity: 0.95; filter: brightness(1.05); }
    100% { opacity: 0.9; filter: brightness(0.9); }
  }

  :global(body) {
    text-shadow: 
      0 0 6px rgba(167, 162, 231, 0.5),
      0 0 15px rgba(167, 162, 231, 0.3);
  }
</style>