---
interface Props {
  title: string;
  date: Date;
  url: string;
}
const { title, date, url } = Astro.props;
const formattedDate = date.toLocaleDateString("es-ES", {
    year: "2-digit",
    month: "2-digit",
    day: "2-digit",
}).replaceAll('/', '.');
---

<a
  href={url}
  class="flex flex-row justify-between items-baseline flex-wrap gap-x-8 gap-y-2 py-3 border-b hover:border-transparent border-primary group transition-all sfx-project"
>
  <h3
    class="text-lg font-medium flex-1 min-w-62.5 wrap-break-word group-hover:text-primary"
  >
    {title}
  </h3>
  <time
    datetime={date.toISOString()}
    class="font-bold whitespace-nowrap shrink-0"
  >
    {formattedDate}
  </time>
</a>
